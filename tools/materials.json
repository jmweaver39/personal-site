  "rules": [
    {
      "match": "(MAIN BODY|TERMINAL BLOCK), DC TO DC",
      "material": "black_plastic",
      "note": "DC-DC converter body - black plastic (user)"
    },
    {
      "match": "(Hex socket head cap screw M3|Socket button head screw M3|Hex nut grade A & B M3|pan cross head.*M3)",
      "material": "black_oxide",
      "note": "all M3 screws + nuts - black (user)"
    },
    {
      "match": "(Hex socket head cap screw M4|Socket button head screw M4|Hex nut grade A & B M4|Hex nut 1/4-20|Threaded Rod)",
      "material": "steel",
      "note": "M4 + 1/4-20 hardware, threaded rods - steel (guess)"
    },
    {
      "match": "Brass Insert",
      "material": "brass",
      "note": "brass (user)"
    },
    {
      "match": "U-Bolt",
      "material": "steel",
      "note": "metal (user)"
    },
    {
      "match": "Bulkhead",
      "material": "pine_wood",
      "note": "the tan plates - pine wood (user)"
    },
    {
      "match": "Acrylic",
      "material": "acrylic_clear",
      "note": "camera/runcam windows - clear acrylic (guess)"
    },
    {
      "match": "(Middle Payload|Battery Cover|Microphone Cover|Microphone Mount|Runcam Mount|Lower Mid Brace|Slow Motion Bracket|Camera Cover|Camera Seal|M3 Hex Holder|Brace|Part [0-9])",
      "material": "pla_gray_dark",
      "gray_only": true,
      "note": "main printed structure - darker gray PLA (user)"
    }
  ]
}